# syntax=docker/dockerfile:1.25@sha256:0adf442eae370b6087e08edc7c50b552d80ddf261576f4ebd6421006b2461f12
# Multi-stage build for the OpenSpeedTest service.
# Clones upstream and replicates upstream's docker/openspeedtest/Dockerfile.

# --- Stage 0: fetch upstream source at the pinned version
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc AS source
# renovate: datasource=github-releases depName=Ozark-Connect/NetworkOptimizer
ARG UPSTREAM_VERSION=v1.24.3
RUN apk add --no-cache git && \
    git clone --depth 1 --branch ${UPSTREAM_VERSION} \
    https://github.com/Ozark-Connect/NetworkOptimizer.git /src

# --- Final stage: nginx with upstream's customized OpenSpeedTest content
# Pin to nginx 1.26 to match upstream (1.29+ has caching behavior changes).
FROM nginx:1.26-alpine@sha256:1eadbb07820339e8bbfed18c771691970baee292ec4ab2558f1453d26153e22d

# tini for signal handling / zombie reaping (defensive; nginx itself handles signals fine)
RUN apk add --no-cache tini

# Customized OpenSpeedTest static files
COPY --link --from=source /src/src/OpenSpeedTest/ /usr/share/nginx/html/

# nginx config
COPY --link --from=source /src/docker/openspeedtest/nginx.conf /etc/nginx/conf.d/default.conf

# Upstream's entrypoint script + our balena start.sh wrapper.
# `COPY --chmod=` would be tidier but balena's classic (non-BuildKit) cloud
# builder explicitly rejects it; stick with the separate `RUN chmod +x`.
COPY --link --from=source /src/docker/openspeedtest/entrypoint.sh /docker-entrypoint.sh
COPY start.sh /usr/local/bin/start.sh
RUN chmod +x /docker-entrypoint.sh /usr/local/bin/start.sh

EXPOSE 3000

# busybox wget ships in the nginx:alpine base — no extra package needed.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:3000/ || exit 1

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/start.sh"]
CMD ["nginx", "-g", "daemon off;"]
