# syntax=docker/dockerfile:1.6
# Multi-stage build for the Network Optimizer .NET service.
# Stage 0 clones upstream at the pinned tag; subsequent stages build from /src.
# Mirrors upstream's docker/Dockerfile so feature parity is preserved.

# --- Stage 0: fetch upstream source at the pinned version
FROM alpine:3.20 AS source
ARG UPSTREAM_VERSION=v1.15.10
RUN apk add --no-cache git
RUN git clone --depth 1 --branch ${UPSTREAM_VERSION} \
    https://github.com/Ozark-Connect/NetworkOptimizer.git /src

# --- Stage 1: build .NET app
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG UPSTREAM_VERSION=v1.15.10
ARG VERSION
WORKDIR /src

# csproj copy first for layer caching (mirrors upstream's order)
COPY --from=source /src/NetworkOptimizer.sln ./
COPY --from=source /src/Directory.Build.props ./
COPY --from=source /src/nuget.config ./
COPY --from=source /src/packages packages
COPY --from=source /src/src/NetworkOptimizer.Core/NetworkOptimizer.Core.csproj src/NetworkOptimizer.Core/
COPY --from=source /src/src/NetworkOptimizer.Web/NetworkOptimizer.Web.csproj src/NetworkOptimizer.Web/
COPY --from=source /src/src/NetworkOptimizer.UniFi/NetworkOptimizer.UniFi.csproj src/NetworkOptimizer.UniFi/
COPY --from=source /src/src/NetworkOptimizer.Audit/NetworkOptimizer.Audit.csproj src/NetworkOptimizer.Audit/
COPY --from=source /src/src/NetworkOptimizer.Sqm/NetworkOptimizer.Sqm.csproj src/NetworkOptimizer.Sqm/
COPY --from=source /src/src/NetworkOptimizer.Monitoring/NetworkOptimizer.Monitoring.csproj src/NetworkOptimizer.Monitoring/
COPY --from=source /src/src/NetworkOptimizer.Storage/NetworkOptimizer.Storage.csproj src/NetworkOptimizer.Storage/
COPY --from=source /src/src/NetworkOptimizer.Agents/NetworkOptimizer.Agents.csproj src/NetworkOptimizer.Agents/
COPY --from=source /src/src/NetworkOptimizer.Reports/NetworkOptimizer.Reports.csproj src/NetworkOptimizer.Reports/
COPY --from=source /src/src/NetworkOptimizer.Diagnostics/NetworkOptimizer.Diagnostics.csproj src/NetworkOptimizer.Diagnostics/
COPY --from=source /src/src/NetworkOptimizer.WiFi/NetworkOptimizer.WiFi.csproj src/NetworkOptimizer.WiFi/
COPY --from=source /src/src/NetworkOptimizer.Alerts/NetworkOptimizer.Alerts.csproj src/NetworkOptimizer.Alerts/
COPY --from=source /src/src/NetworkOptimizer.Threats/NetworkOptimizer.Threats.csproj src/NetworkOptimizer.Threats/

RUN dotnet restore "src/NetworkOptimizer.Web/NetworkOptimizer.Web.csproj"

COPY --from=source /src/src src

# Default the .NET assembly version to UPSTREAM_VERSION (sans 'v') if VERSION arg unset.
RUN MINVER_VERSION="${VERSION:-${UPSTREAM_VERSION#v}}" && \
    dotnet publish "src/NetworkOptimizer.Web/NetworkOptimizer.Web.csproj" \
        -c Release \
        -o /app/publish \
        --no-restore \
        -p:MinVerVersionOverride=${MINVER_VERSION}

# --- Stage 2: build uwnspeedtest Go binaries
#  - Local (matches container arch): server-side WAN speed tests
#  - Gateway (always linux/arm64): SSH-deployed to UniFi gateways
FROM golang:1.22-alpine AS uwnspeedtest-build
ARG TARGETARCH=amd64
ARG UPSTREAM_VERSION=v1.15.10
WORKDIR /src
COPY --from=source /src/src/cfspeedtest cfspeedtest
COPY --from=source /src/src/uwnspeedtest uwnspeedtest
WORKDIR /src/uwnspeedtest
RUN VERSION_TRIM="${UPSTREAM_VERSION#v}" && \
    case "${TARGETARCH}" in \
        arm) export GOARM=7 ;; \
    esac && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath \
        -ldflags "-s -w -X main.version=${VERSION_TRIM}" \
        -o /uwnspeedtest-local . && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath \
        -ldflags "-s -w -X main.version=${VERSION_TRIM}" \
        -o /uwnspeedtest-gateway .

# --- Stage 3: build wansteer (gateway-only, always linux/arm64)
FROM golang:1.22-alpine AS wansteer-build
ARG UPSTREAM_VERSION=v1.15.10
WORKDIR /src
COPY --from=source /src/src/wansteer wansteer
WORKDIR /src/wansteer
RUN VERSION_TRIM="${UPSTREAM_VERSION#v}" && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath \
        -ldflags "-s -w -X main.version=${VERSION_TRIM}" \
        -o /wansteer-gateway .

# --- Stage 4: build iperf3 from source (latest stable)
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS iperf-build
ARG IPERF3_VERSION=3.20
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp
RUN curl -fLO --retry 3 --retry-delay 5 \
        https://github.com/esnet/iperf/releases/download/${IPERF3_VERSION}/iperf-${IPERF3_VERSION}.tar.gz \
    && tar xzf iperf-${IPERF3_VERSION}.tar.gz \
    && cd iperf-${IPERF3_VERSION} \
    && ./configure --prefix=/usr/local \
    && make \
    && make install

# --- Stage 5: runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ARG TARGETARCH=amd64

WORKDIR /app

# Runtime utilities + tini (init: zombie reaper + signal proxy).
# libssl3 was renamed libssl3t64 on Ubuntu's 32-bit arches (armhf, i386) as
# part of the 64-bit time_t transition; pick the right name per arch.
RUN apt-get update && \
    case "${TARGETARCH}" in \
        arm) LIBSSL_PKG="libssl3t64" ;; \
        *)   LIBSSL_PKG="libssl3"    ;; \
    esac && \
    apt-get install -y --no-install-recommends \
        curl iputils-ping ${LIBSSL_PKG} gosu sqlite3 tini ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# iperf3 from source build
COPY --from=iperf-build /usr/local/bin/iperf3 /usr/local/bin/
COPY --from=iperf-build /usr/local/lib/libiperf* /usr/local/lib/
RUN ldconfig

# Published .NET app
COPY --from=build /app/publish ./

# Tools dir + Go binaries
RUN mkdir -p /app/tools
COPY --from=uwnspeedtest-build /uwnspeedtest-local /app/tools/uwnspeedtest-linux-${TARGETARCH:-amd64}
COPY --from=uwnspeedtest-build /uwnspeedtest-gateway /app/tools/uwnspeedtest-linux-arm64
COPY --from=wansteer-build /wansteer-gateway /app/tools/wansteer-linux-arm64

# Volume mount points so upstream's chown succeeds on first run
RUN mkdir -p /app/data /app/ssh-keys /app/logs

# Upstream's entrypoint — chowns volumes, drops to 'app' user, execs dotnet
COPY --from=source /src/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Our balena start.sh wrapper — env dump for troubleshooting, then exec upstream entrypoint
COPY start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh

ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_HTTP_PORTS=8042 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

EXPOSE 8042
EXPOSE 5201

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8042/api/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/start.sh"]
