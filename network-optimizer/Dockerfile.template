# syntax=docker/dockerfile:1.24@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
# Multi-stage build for the Network Optimizer .NET service.
# Stage 0 clones upstream at the pinned tag; subsequent stages build from /src.
# Mirrors upstream's docker/Dockerfile so feature parity is preserved.
#
# balena builds from THIS file (native per-arch workers, no QEMU). The GHCR
# mirror cross-builds via buildx+QEMU and uses network-optimizer/Dockerfile.ghcr
# instead — a copy of this file whose ONLY difference is the Stage 1 FROM
# (pinned to $BUILDPLATFORM). Keep both in sync for every other stage.
# Do NOT add `--platform=$BUILDPLATFORM` here: balena's classic builder is
# not BuildKit, leaves BUILDPLATFORM empty, and rejects an empty --platform=.

# --- Stage 0: fetch upstream source at the pinned version
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc AS source
# renovate: datasource=github-releases depName=Ozark-Connect/NetworkOptimizer
ARG UPSTREAM_VERSION=v1.19.5
RUN apk add --no-cache git && \
    git clone --depth 1 --branch ${UPSTREAM_VERSION} \
    https://github.com/Ozark-Connect/NetworkOptimizer.git /src

# DRIFT-ALLOWED: BEGIN  Stage 1 .NET FROM — Dockerfile.ghcr pins this to --platform=$BUILDPLATFORM for cross-build; balena's classic builder rejects an empty --platform=.
# --- Stage 1: build .NET app
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:548d93f8a18a1acbe6cc127bc4f47281430d34a9e35c18afa80a8d6741c2adc3 AS build
# DRIFT-ALLOWED: END
# renovate: datasource=github-releases depName=Ozark-Connect/NetworkOptimizer
ARG UPSTREAM_VERSION=v1.19.5
ARG VERSION
WORKDIR /src

# csproj copy first for layer caching (mirrors upstream's order)
COPY --link --from=source /src/NetworkOptimizer.sln ./
COPY --link --from=source /src/Directory.Build.props ./
COPY --link --from=source /src/nuget.config ./
COPY --link --from=source /src/packages packages
COPY --link --from=source /src/src/NetworkOptimizer.Core/NetworkOptimizer.Core.csproj src/NetworkOptimizer.Core/
COPY --link --from=source /src/src/NetworkOptimizer.Web/NetworkOptimizer.Web.csproj src/NetworkOptimizer.Web/
COPY --link --from=source /src/src/NetworkOptimizer.UniFi/NetworkOptimizer.UniFi.csproj src/NetworkOptimizer.UniFi/
COPY --link --from=source /src/src/NetworkOptimizer.Audit/NetworkOptimizer.Audit.csproj src/NetworkOptimizer.Audit/
COPY --link --from=source /src/src/NetworkOptimizer.Sqm/NetworkOptimizer.Sqm.csproj src/NetworkOptimizer.Sqm/
COPY --link --from=source /src/src/NetworkOptimizer.Monitoring/NetworkOptimizer.Monitoring.csproj src/NetworkOptimizer.Monitoring/
COPY --link --from=source /src/src/NetworkOptimizer.Storage/NetworkOptimizer.Storage.csproj src/NetworkOptimizer.Storage/
COPY --link --from=source /src/src/NetworkOptimizer.Agents/NetworkOptimizer.Agents.csproj src/NetworkOptimizer.Agents/
COPY --link --from=source /src/src/NetworkOptimizer.Reports/NetworkOptimizer.Reports.csproj src/NetworkOptimizer.Reports/
COPY --link --from=source /src/src/NetworkOptimizer.Diagnostics/NetworkOptimizer.Diagnostics.csproj src/NetworkOptimizer.Diagnostics/
COPY --link --from=source /src/src/NetworkOptimizer.WiFi/NetworkOptimizer.WiFi.csproj src/NetworkOptimizer.WiFi/
COPY --link --from=source /src/src/NetworkOptimizer.Alerts/NetworkOptimizer.Alerts.csproj src/NetworkOptimizer.Alerts/
COPY --link --from=source /src/src/NetworkOptimizer.Threats/NetworkOptimizer.Threats.csproj src/NetworkOptimizer.Threats/

RUN dotnet restore "src/NetworkOptimizer.Web/NetworkOptimizer.Web.csproj"

COPY --link --from=source /src/src src

# Default the .NET assembly version to UPSTREAM_VERSION (sans 'v') if VERSION arg unset.
RUN MINVER_VERSION="${VERSION:-${UPSTREAM_VERSION#v}}" && \
    dotnet publish "src/NetworkOptimizer.Web/NetworkOptimizer.Web.csproj" \
        -c Release \
        -o /app/publish \
        --no-restore \
        -p:MinVerVersionOverride=${MINVER_VERSION}

# DRIFT-ALLOWED: BEGIN  Stage go-build — Dockerfile.ghcr cross-compiles on BUILDPLATFORM (amd64 runner) via TARGETARCH/TARGETVARIANT; this file builds natively on balena's per-arch workers via uname -m. Same /binaries/ outputs either way.
# --- Stage 2: build all Go binaries (uwnspeedtest + wansteer)
#  - uwnspeedtest local: matches container arch (in-container WAN tests)
#  - uwnspeedtest gateway: always linux/arm64 (SSH-deployed to UniFi gateways)
#  - wansteer gateway: always linux/arm64 (SSH-deployed)
# Each binary is named with its final `-linux-<arch>` suffix so the runtime
# stage can copy /binaries/ in one shot without a rename dance. On arm64
# the local and gateway uwnspeedtest binaries are functionally identical
# and share the file `uwnspeedtest-linux-arm64`.
#
# Detect arch via `uname -m` rather than ${TARGETARCH}: balena's classic
# builder doesn't auto-populate the BuildKit TARGETARCH ARG, so the kernel's
# own view (set by Docker per-image-arch, including under QEMU emulation) is
# what we need.
FROM golang:1.26-alpine@sha256:f23e8b227fb4493eabe03bede4d5a32d04092da71962f1fb79b5f7d1e6c2a17f AS go-build
# renovate: datasource=github-releases depName=Ozark-Connect/NetworkOptimizer
ARG UPSTREAM_VERSION=v1.19.5
WORKDIR /src
COPY --link --from=source /src/src/cfspeedtest cfspeedtest
COPY --link --from=source /src/src/uwnspeedtest uwnspeedtest
COPY --link --from=source /src/src/wansteer wansteer

RUN set -eux; \
    VERSION_TRIM="${UPSTREAM_VERSION#v}"; \
    case "$(uname -m)" in \
        x86_64)  GOARCH=amd64 GOARM= ARCH_SUFFIX=amd64 ;; \
        aarch64) GOARCH=arm64 GOARM= ARCH_SUFFIX=arm64 ;; \
        armv7l)  GOARCH=arm   GOARM=7 ARCH_SUFFIX=arm   ;; \
        armv6l)  GOARCH=arm   GOARM=6 ARCH_SUFFIX=arm   ;; \
        i686)    GOARCH=386   GOARM= ARCH_SUFFIX=386   ;; \
        *) echo "Unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    mkdir -p /binaries; \
    cd /src/uwnspeedtest; \
    CGO_ENABLED=0 GOOS=linux GOARCH="${GOARCH}" GOARM="${GOARM}" \
        go build -trimpath -ldflags "-s -w -X main.version=${VERSION_TRIM}" \
        -o "/binaries/uwnspeedtest-linux-${ARCH_SUFFIX}" .; \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
        go build -trimpath -ldflags "-s -w -X main.version=${VERSION_TRIM}" \
        -o /binaries/uwnspeedtest-linux-arm64 .; \
    cd /src/wansteer; \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 \
        go build -trimpath -ldflags "-s -w -X main.version=${VERSION_TRIM}" \
        -o /binaries/wansteer-linux-arm64 .
# DRIFT-ALLOWED: END

# DRIFT-ALLOWED: BEGIN  Stage iperf-build — Dockerfile.ghcr cross-compiles via Debian crossbuild-essential + multiarch libssl-dev; this file builds natively on the target-arch dotnet/aspnet image (balena's per-arch workers run native, no QEMU).
# --- Stage 4: build iperf3 from source (latest stable)
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:ddcf70ad1ab963a4fcd41fbd722a6b660e404e87567cfbd46fd2809c21b02088 AS iperf-build
# renovate: datasource=github-releases depName=esnet/iperf
ARG IPERF3_VERSION=3.21
# apt under QEMU emulation (arm64/arm-v7 legs of the GHCR mirror build) is
# prone to transient `Unable to connect to ports.ubuntu.com:80` failures —
# Release 0.3.0's GHCR publish hit this. Retry the whole update+install up
# to 3 times before giving up.
RUN for i in 1 2 3; do \
        if apt-get update && apt-get install -y --no-install-recommends \
            build-essential curl libssl-dev ca-certificates; then \
            break; \
        fi; \
        echo "apt attempt $i failed; retrying in 5s..." >&2; \
        if [ "$i" = 3 ]; then exit 1; fi; \
        sleep 5; \
    done \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp
RUN curl -fLO --retry 3 --retry-delay 5 \
        https://github.com/esnet/iperf/releases/download/${IPERF3_VERSION}/iperf-${IPERF3_VERSION}.tar.gz \
    && tar xzf iperf-${IPERF3_VERSION}.tar.gz \
    && mv iperf-${IPERF3_VERSION} iperf-src
WORKDIR /tmp/iperf-src
RUN ./configure --prefix=/usr/local \
    && make \
    && make install
# DRIFT-ALLOWED: END

# --- Stage 5: runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:ddcf70ad1ab963a4fcd41fbd722a6b660e404e87567cfbd46fd2809c21b02088 AS runtime

WORKDIR /app

# Runtime utilities + tini (init: zombie reaper + signal proxy).
# libssl3 was renamed libssl3t64 on Ubuntu's 32-bit arches (armhf, i386) as
# part of the 64-bit time_t transition; pick the right name per arch.
# Use `dpkg --print-architecture` rather than ${TARGETARCH}: balena's classic
# builder doesn't auto-populate the BuildKit TARGETARCH ARG, so dpkg's view of
# the container's own arch is more reliable.
RUN apt-get update && \
    case "$(dpkg --print-architecture)" in \
        armhf|i386) LIBSSL_PKG="libssl3t64" ;; \
        *)          LIBSSL_PKG="libssl3"    ;; \
    esac && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl gosu iputils-ping ${LIBSSL_PKG} sqlite3 tini \
    && rm -rf /var/lib/apt/lists/*

# iperf3 from source build
COPY --link --from=iperf-build /usr/local/bin/iperf3 /usr/local/bin/
COPY --link --from=iperf-build /usr/local/lib/libiperf* /usr/local/lib/
RUN ldconfig

# Published .NET app
COPY --link --from=build /app/publish ./

# All Go binaries land here with their final names already set:
#   uwnspeedtest-linux-<host-arch>   (local, for in-container WAN tests)
#   uwnspeedtest-linux-arm64         (gateway, SSH-deployed to UniFi)
#   wansteer-linux-arm64             (gateway, SSH-deployed to UniFi)
# On arm64 hosts the first two share the same arm64 binary and resolve to
# one file in /app/tools — the .NET app's filename contract is preserved.
COPY --link --from=go-build /binaries/ /app/tools/

# Tools dir already created above by the COPY; this ensures volume mounts
# (so upstream's entrypoint chown succeeds on first run).
RUN mkdir -p /app/data /app/ssh-keys /app/logs

# Upstream's entrypoint — chowns volumes, drops to 'app' user, execs dotnet.
# Our balena start.sh wrapper — env dump for troubleshooting, then exec
# upstream entrypoint. `COPY --chmod=` would be tidier but balena's classic
# (non-BuildKit) cloud builder explicitly rejects it; stick with the
# separate `RUN chmod +x`.
COPY --link --from=source /src/docker/entrypoint.sh /entrypoint.sh
COPY start.sh /usr/local/bin/start.sh
RUN chmod +x /entrypoint.sh /usr/local/bin/start.sh

ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_HTTP_PORTS=8042 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

EXPOSE 8042
EXPOSE 5201

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8042/api/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/start.sh"]
