# syntax=docker/dockerfile:1.6
# Multi-stage build for the Network Optimizer .NET service.
# Stage 0 clones upstream at the pinned tag; subsequent stages build from /src.
# Mirrors upstream's docker/Dockerfile so feature parity is preserved.
#
# *** GHCR / buildx ONLY — NOT for balena. ***
# This is a copy of Dockerfile.template that differs in EXACTLY ONE place:
# Stage 1's `FROM` is pinned to --platform=$BUILDPLATFORM so the .NET SDK
# cross-builds natively on the amd64 GitHub runner (no QEMU -> no exit 134).
# balena builds every arch on native workers (no QEMU) and uses
# Dockerfile.template, whose classic (non-BuildKit) builder rejects an
# empty `--platform=`. Keep this file in sync with Dockerfile.template for
# EVERY stage except the Stage 1 FROM line below.

# --- Stage 0: fetch upstream source at the pinned version
FROM alpine:3.20 AS source
# renovate: datasource=github-releases depName=Ozark-Connect/NetworkOptimizer
ARG UPSTREAM_VERSION=v1.15.10
RUN apk add --no-cache git && \
    git clone --depth 1 --branch ${UPSTREAM_VERSION} \
    https://github.com/Ozark-Connect/NetworkOptimizer.git /src

# --- Stage 1: build .NET app (SDK runs on the BUILD platform, not the target)
# Upstream's entrypoint runs `dotnet NetworkOptimizer.Web.dll` (verified in
# upstream docker/entrypoint.sh @ v1.15.10) — framework-dependent, portable
# IL; the native apphost is never executed. So the publish output is
# architecture-neutral and the per-target aspnet runtime stage can COPY it
# as-is. Pinning this stage to BUILDPLATFORM keeps buildx multi-arch builds
# (the GHCR mirror) from running the .NET SDK under QEMU: `dotnet restore`
# SIGABRTs (exit 134) under arm/v7 emulation (CI run 26080536696). Pinning
# QEMU (commit 56e73fc) did not help and is abandoned.
# BUILDPLATFORM is auto-populated by BuildKit (buildx/GHCR only). balena's
# classic builder is NOT BuildKit, leaves it empty, and rejects an empty
# `--platform=` — which is why this cross-build lives in this GHCR-only file
# and Dockerfile.template (built by balena's native per-arch workers) does
# NOT carry it. THIS LINE is the only intended difference from the template.
ARG BUILDPLATFORM
FROM --platform=${BUILDPLATFORM} mcr.microsoft.com/dotnet/sdk:10.0 AS build
# renovate: datasource=github-releases depName=Ozark-Connect/NetworkOptimizer
ARG UPSTREAM_VERSION=v1.15.10
ARG VERSION
WORKDIR /src

# csproj copy first for layer caching (mirrors upstream's order)
COPY --link --from=source /src/NetworkOptimizer.sln ./
COPY --link --from=source /src/Directory.Build.props ./
COPY --link --from=source /src/nuget.config ./
COPY --link --from=source /src/packages packages
COPY --link --from=source /src/src/NetworkOptimizer.Core/NetworkOptimizer.Core.csproj src/NetworkOptimizer.Core/
COPY --link --from=source /src/src/NetworkOptimizer.Web/NetworkOptimizer.Web.csproj src/NetworkOptimizer.Web/
COPY --link --from=source /src/src/NetworkOptimizer.UniFi/NetworkOptimizer.UniFi.csproj src/NetworkOptimizer.UniFi/
COPY --link --from=source /src/src/NetworkOptimizer.Audit/NetworkOptimizer.Audit.csproj src/NetworkOptimizer.Audit/
COPY --link --from=source /src/src/NetworkOptimizer.Sqm/NetworkOptimizer.Sqm.csproj src/NetworkOptimizer.Sqm/
COPY --link --from=source /src/src/NetworkOptimizer.Monitoring/NetworkOptimizer.Monitoring.csproj src/NetworkOptimizer.Monitoring/
COPY --link --from=source /src/src/NetworkOptimizer.Storage/NetworkOptimizer.Storage.csproj src/NetworkOptimizer.Storage/
COPY --link --from=source /src/src/NetworkOptimizer.Agents/NetworkOptimizer.Agents.csproj src/NetworkOptimizer.Agents/
COPY --link --from=source /src/src/NetworkOptimizer.Reports/NetworkOptimizer.Reports.csproj src/NetworkOptimizer.Reports/
COPY --link --from=source /src/src/NetworkOptimizer.Diagnostics/NetworkOptimizer.Diagnostics.csproj src/NetworkOptimizer.Diagnostics/
COPY --link --from=source /src/src/NetworkOptimizer.WiFi/NetworkOptimizer.WiFi.csproj src/NetworkOptimizer.WiFi/
COPY --link --from=source /src/src/NetworkOptimizer.Alerts/NetworkOptimizer.Alerts.csproj src/NetworkOptimizer.Alerts/
COPY --link --from=source /src/src/NetworkOptimizer.Threats/NetworkOptimizer.Threats.csproj src/NetworkOptimizer.Threats/

RUN dotnet restore "src/NetworkOptimizer.Web/NetworkOptimizer.Web.csproj"

COPY --link --from=source /src/src src

# Default the .NET assembly version to UPSTREAM_VERSION (sans 'v') if VERSION arg unset.
RUN MINVER_VERSION="${VERSION:-${UPSTREAM_VERSION#v}}" && \
    dotnet publish "src/NetworkOptimizer.Web/NetworkOptimizer.Web.csproj" \
        -c Release \
        -o /app/publish \
        --no-restore \
        -p:MinVerVersionOverride=${MINVER_VERSION}

# --- Stage 2: build uwnspeedtest Go binaries
#  - Local (matches container arch): server-side WAN speed tests
#  - Gateway (always linux/arm64): SSH-deployed to UniFi gateways
# Detect arch via `uname -m` rather than ${TARGETARCH}: balena's classic
# builder doesn't auto-populate the BuildKit TARGETARCH ARG, so the kernel's
# own view (set by Docker per-image-arch, including under QEMU emulation) is
# what we need.
FROM golang:1.26-alpine AS uwnspeedtest-build
# renovate: datasource=github-releases depName=Ozark-Connect/NetworkOptimizer
ARG UPSTREAM_VERSION=v1.15.10
WORKDIR /src
COPY --link --from=source /src/src/cfspeedtest cfspeedtest
COPY --link --from=source /src/src/uwnspeedtest uwnspeedtest
WORKDIR /src/uwnspeedtest
RUN VERSION_TRIM="${UPSTREAM_VERSION#v}" && \
    case "$(uname -m)" in \
        x86_64)  LOCAL_GOARCH=amd64 LOCAL_GOARM= ;; \
        aarch64) LOCAL_GOARCH=arm64 LOCAL_GOARM= ;; \
        armv7l)  LOCAL_GOARCH=arm   LOCAL_GOARM=7 ;; \
        armv6l)  LOCAL_GOARCH=arm   LOCAL_GOARM=6 ;; \
        i686)    LOCAL_GOARCH=386   LOCAL_GOARM= ;; \
        *) echo "Unsupported arch: $(uname -m)"; exit 1 ;; \
    esac && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${LOCAL_GOARCH} GOARM=${LOCAL_GOARM} \
        go build -trimpath \
        -ldflags "-s -w -X main.version=${VERSION_TRIM}" \
        -o /uwnspeedtest-local . && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath \
        -ldflags "-s -w -X main.version=${VERSION_TRIM}" \
        -o /uwnspeedtest-gateway .

# --- Stage 3: build wansteer (gateway-only, always linux/arm64)
FROM golang:1.26-alpine AS wansteer-build
# renovate: datasource=github-releases depName=Ozark-Connect/NetworkOptimizer
ARG UPSTREAM_VERSION=v1.15.10
WORKDIR /src
COPY --link --from=source /src/src/wansteer wansteer
WORKDIR /src/wansteer
RUN VERSION_TRIM="${UPSTREAM_VERSION#v}" && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath \
        -ldflags "-s -w -X main.version=${VERSION_TRIM}" \
        -o /wansteer-gateway .

# --- Stage 4: build iperf3 from source (latest stable)
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS iperf-build
# renovate: datasource=github-releases depName=esnet/iperf
ARG IPERF3_VERSION=3.21
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp
RUN curl -fLO --retry 3 --retry-delay 5 \
        https://github.com/esnet/iperf/releases/download/${IPERF3_VERSION}/iperf-${IPERF3_VERSION}.tar.gz \
    && tar xzf iperf-${IPERF3_VERSION}.tar.gz \
    && mv iperf-${IPERF3_VERSION} iperf-src
WORKDIR /tmp/iperf-src
RUN ./configure --prefix=/usr/local \
    && make \
    && make install

# --- Stage 5: runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

WORKDIR /app

# Runtime utilities + tini (init: zombie reaper + signal proxy).
# libssl3 was renamed libssl3t64 on Ubuntu's 32-bit arches (armhf, i386) as
# part of the 64-bit time_t transition; pick the right name per arch.
# Use `dpkg --print-architecture` rather than ${TARGETARCH}: balena's classic
# builder doesn't auto-populate the BuildKit TARGETARCH ARG, so dpkg's view of
# the container's own arch is more reliable.
RUN apt-get update && \
    case "$(dpkg --print-architecture)" in \
        armhf|i386) LIBSSL_PKG="libssl3t64" ;; \
        *)          LIBSSL_PKG="libssl3"    ;; \
    esac && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl gosu iputils-ping ${LIBSSL_PKG} sqlite3 tini \
    && rm -rf /var/lib/apt/lists/*

# iperf3 from source build
COPY --link --from=iperf-build /usr/local/bin/iperf3 /usr/local/bin/
COPY --link --from=iperf-build /usr/local/lib/libiperf* /usr/local/lib/
RUN ldconfig

# Published .NET app
COPY --link --from=build /app/publish ./

# Tools dir + Go binaries.
# Gateway binaries always live at their fixed arm64 names. The local
# uwnspeedtest binary lands first at a temp path, then gets renamed to
# `uwnspeedtest-linux-<arch>` based on the runtime image's actual arch
# (the .NET app looks for that filename pattern).
RUN mkdir -p /app/tools
COPY --link --from=uwnspeedtest-build /uwnspeedtest-local /tmp/uwnspeedtest-local
COPY --link --from=uwnspeedtest-build /uwnspeedtest-gateway /app/tools/uwnspeedtest-linux-arm64
COPY --link --from=wansteer-build /wansteer-gateway /app/tools/wansteer-linux-arm64
RUN case "$(dpkg --print-architecture)" in \
        amd64) ARCH_SUFFIX=amd64 ;; \
        arm64) ARCH_SUFFIX=arm64 ;; \
        armhf) ARCH_SUFFIX=arm   ;; \
        i386)  ARCH_SUFFIX=386   ;; \
        *) echo "Unsupported arch: $(dpkg --print-architecture)"; exit 1 ;; \
    esac && \
    mv /tmp/uwnspeedtest-local /app/tools/uwnspeedtest-linux-${ARCH_SUFFIX}

# Volume mount points so upstream's chown succeeds on first run
RUN mkdir -p /app/data /app/ssh-keys /app/logs

# Upstream's entrypoint — chowns volumes, drops to 'app' user, execs dotnet
COPY --link --from=source /src/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Our balena start.sh wrapper — env dump for troubleshooting, then exec upstream entrypoint
COPY start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh

ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_HTTP_PORTS=8042 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

EXPOSE 8042
EXPOSE 5201

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8042/api/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/start.sh"]
