{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "schedule": ["before 5am on Monday"],
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "commitBody": "Signed-off-by: renovate[bot] <renovate[bot]@users.noreply.github.com>",
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/**"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["docker/**"],
      "groupName": "docker actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "/codeql/",
        "/scorecard/",
        "/trivy/",
        "/cosign/",
        "/sbom-action/",
        "/action-gh-release/",
        "/trufflehog/",
        "/harden-runner/"
      ],
      "groupName": "security actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["balena-io/**"],
      "groupName": "balena actions"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "versioning": "semver"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mcr.microsoft.com/dotnet/**"],
      "groupName": "dotnet images"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "groupName": "golang image"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nginx"],
      "versioning": "semver"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["Ozark-Connect/NetworkOptimizer"],
      "groupName": "upstream NetworkOptimizer",
      "addLabels": ["upstream"]
    },
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["esnet/iperf"],
      "groupName": "iperf3"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/Dockerfile\\.template$/"
      ],
      "matchStrings": [
        "# renovate: alpine-package=(?<packageName>[^\\n]+)\\nARG (?:[A-Z0-9_]+)_VERSION=(?<currentValue>[^\\n]+)"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "depNameTemplate": "alpine_3_20/{{{packageName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/Dockerfile\\.template$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\n]+)\\nARG (?:[A-Z0-9_]+)=(?<currentValue>[^\\n]+)"
      ]
    }
  ]
}
